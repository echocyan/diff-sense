{
  "name": "@echocyan/diff-sense",
  "version": "0.1.1",
  "description": "轻量级 AI 驱动的代码审查 CLI 工具",
  "type": "module",
  "bin": {
    "diff-sense": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "cli",
    "diff",
    "git",
    "github-action"
  ],
  "homepage": "https://github.com/echocyan/diff-sense#readme",
  "bugs": {
    "url": "https://github.com/echocyan/diff-sense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echocyan/diff-sense.git"
  },
  "author": "EchoCyan",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/deepseek": "^3.0.49",
    "@ai-sdk/openai": "^4.0.71",
    "@clack/prompts": "^1.8.1",
    "ai": "^7.0.107",
    "commander": "^15.0.0",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  }
}
